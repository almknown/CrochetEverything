# ============================================
# APP CONFIGURATION
# ============================================
# The app URL is automatically determined by Vercel.
# Set CUSTOM_DOMAIN when you're ready to use your own domain.

# Optional: Override the auto-detected URL (usually not needed)
# NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# Optional: Custom domain for production (leave empty until ready)
# CUSTOM_DOMAIN=your-domain.com

# ============================================
# GEMINI AI (Required for CrochetAI)
# ============================================
# Get this from: https://aistudio.google.com/apikey
# Free tier available!

GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# CLERK AUTHENTICATION
# ============================================
# ============================================
# Get these from: https://dashboard.clerk.com
# Create a free account → Create application → Copy keys

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Auth page routes (these match the file structure)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ============================================
# DATABASE (NEON)
# ============================================
# Get this from: https://console.neon.tech
# Create a free project → Connection Details → Copy connection string

DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ============================================
# PAYMENTS: STRIPE (Option A)
# ============================================
# Get these from: https://dashboard.stripe.com/test/apikeys
# Use TEST mode keys for development!

STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# To get webhook secret:
# 1. Go to Developers → Webhooks → Add endpoint
# 2. URL: https://your-project.vercel.app/api/webhooks/stripe
# 3. Select events: customer.subscription.*
# 4. Copy the signing secret

# ============================================
# PAYMENTS: LEMON SQUEEZY (Option B)
# ============================================
# Get these from: https://app.lemonsqueezy.com/settings/api
# Alternative to Stripe, especially good for digital products

# LEMONSQUEEZY_API_KEY=xxxxx
# LEMONSQUEEZY_WEBHOOK_SECRET=xxxxx

# To get webhook secret:
# 1. Go to Settings → Webhooks → Add webhook
# 2. URL: https://your-project.vercel.app/api/webhooks/lemonsqueezy
# 3. Select events: subscription_*
# 4. Copy the signing secret

# ============================================
# EMAIL (RESEND) - Optional
# ============================================
# Get this from: https://resend.com/api-keys
# Free tier: 3,000 emails/month

# RESEND_API_KEY=re_xxxxx

# ============================================
# ANALYTICS (POSTHOG) - Optional
# ============================================
# Get this from: https://posthog.com → Project Settings → API Key
# Free tier: 1M events/month

# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================
# STORAGE (UPLOADTHING) - Optional
# ============================================
# Get these from: https://uploadthing.com/dashboard
# Free tier: 2GB storage

# UPLOADTHING_TOKEN=xxxxx

# ============================================
# STORAGE (CLOUDFLARE R2) - Optional
# ============================================
# Alternative to Uploadthing, more control
# Get from: Cloudflare Dashboard → R2 → API Tokens

# R2_ACCESS_KEY_ID=xxxxx
# R2_SECRET_ACCESS_KEY=xxxxx
# R2_BUCKET_NAME=your-bucket
# R2_ACCOUNT_ID=xxxxx
